<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_ocean</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">220</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_ocean</item>
        <item name="android:navigationBarColor">@color/splash_ocean</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ocean</item>
        <item name="android:statusBarColor">@color/splash_ocean</item>
        <item name="android:navigationBarColor">@color/splash_ocean</item>
    </style>
</resources>
