NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
TIMEZONE=Asia/Ho_Chi_Minh

MONGODB_URI=mongodb://127.0.0.1:27017/chi_muoi_db

JWT_ACCESS_SECRET=default_jwt_access_secret_key_32_chars_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=default_jwt_refresh_secret_key_32_chars_min!
JWT_REFRESH_EXPIRES_IN=90d

CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=secret
CLOUDINARY_FOLDER=chi-muoi/boat-receipts

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

SEED_USER_USERNAME=admin
SEED_USER_PASSWORD=chimuoi@123
SEED_USER_DISPLAY_NAME=Mẹ
